# ================================================================
# ParkVision AI - Backend Environment Configuration
# ================================================================

# Application
APP_NAME="ParkVision AI Backend"
DEBUG=True
AI_MODE=demo

# Database Configuration
# Defaults to SQLite if not provided or if PostgreSQL is unavailable
DATABASE_URL=sqlite:///./parkvision.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/parkvision

# Security
SECRET_KEY=parkvision-production-secret-key-hackathon-2026

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# Demo Simulation
# How frequently (in seconds) the demo background simulation updates parking bays
SIMULATION_INTERVAL_SECONDS=4.0

# External APIs (Optional)
GOOGLE_MAPS_API_KEY=
